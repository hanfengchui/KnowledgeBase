spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/knowledge_assistant
    username: postgres
    password: postgres
  ai:
    openai:
      # Fill this via environment variable instead of committing a real key:
      # export BAILIAN_API_KEY="sk-..."
      api-key: ${BAILIAN_API_KEY:}
      base-url: ${BAILIAN_BASE_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
      chat:
        completions-path: /chat/completions
        options:
          model: ${AI_CHAT_MODEL:qwen-plus}
          temperature: 0.2
      embedding:
        embeddings-path: /embeddings
        options:
          model: ${AI_EMBEDDING_MODEL:text-embedding-v4}
          dimensions: ${AI_EMBEDDING_DIMENSIONS:1024}
    vectorstore:
      pgvector:
        # text-embedding-v4 is configured to return 1024-dimensional embeddings.
        table-name: local_vector_store
        dimensions: 1024

app:
  knowledge-assistant:
    chat-model: ${AI_CHAT_MODEL:qwen-plus}
    embedding-model: ${AI_EMBEDDING_MODEL:text-embedding-v4}
    vector-table-name: local_vector_store
    vector-enabled: true
  security:
    jwt-secret: change-this-demo-secret-before-production
    access-token-ttl-minutes: 120
    bootstrap-admin:
      username: platform-admin
      password: ChangeMe123!
